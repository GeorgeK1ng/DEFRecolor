#include "resource.h"
#include <windows.h>
#include <winver.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDI_DEFRECOLOR ICON "DEFRecolor.ico"
IDI_SMALL ICON "small.ico"

IDC_DEFRECOLOR MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "E&xit", IDM_EXIT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About ...", IDM_ABOUT
    END
END

IDC_DEFRECOLOR ACCELERATORS
BEGIN
    "?", IDM_ABOUT, ASCII, ALT
    "/", IDM_ABOUT, ASCII, ALT
    "L", IDM_LOAD_DEF, VIRTKEY, CONTROL
    "S", IDM_SAVE_DEF, VIRTKEY, CONTROL
    "E", IDM_EXPORT_JSON, VIRTKEY, CONTROL
    "I", IDM_IMPORT_JSON, VIRTKEY, CONTROL
END

IDD_ABOUTBOX DIALOGEX 0, 0, 170, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About DEFRecolor"
FONT 8, "MS Shell Dlg"
BEGIN
    ICON IDI_DEFRECOLOR, IDC_STATIC, 14, 14, 21, 20
    LTEXT "DEFRecolor", IDC_STATIC, 42, 14, 114, 8, SS_NOPREFIX
    LTEXT "Copyright (c) 2024-2026", IDC_STATIC, 42, 26, 114, 8
    DEFPUSHBUTTON "OK", IDOK, 113, 41, 50, 14, WS_GROUP
END

STRINGTABLE
BEGIN
    IDC_DEFRECOLOR "DEFRECOLOR"
    IDS_APP_TITLE "DEFRecolor"
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "GeorgeK1ng\0"
            VALUE "FileDescription", "Heroes III DEF Palette Recoloring Editor\0"
            VALUE "FileVersion", "1.1.0.0\0"
            VALUE "InternalName", "DEFRecolor\0"
            VALUE "LegalCopyright", "Copyright (c) 2024-2026 GeorgeK1ng\0"
            VALUE "OriginalFilename", "DEFRecolor.exe\0"
            VALUE "ProductName", "DEFRecolor\0"
            VALUE "ProductVersion", "1.1.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
